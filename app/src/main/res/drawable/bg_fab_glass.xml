<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮按钮：柔光玻璃（半透明渐变 + 白色柔光高光 + 细描边，安全无系统模糊） -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <layer-list>
            <!-- 半透明底色渐变 -->
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:startColor="#B87AA8FF"
                        android:endColor="#B8C8A2FF"
                        android:angle="45"/>
                </shape>
            </item>
            <!-- 左上柔光高光 -->
            <item
                android:top="4dp"
                android:left="6dp"
                android:right="14dp"
                android:bottom="14dp">
                <shape android:shape="oval">
                    <gradient
                        android:startColor="#66FFFFFF"
                        android:endColor="#00FFFFFF"
                        android:angle="315"/>
                </shape>
            </item>
            <!-- 玻璃描边 -->
            <item>
                <shape android:shape="oval">
                    <stroke android:width="1.5dp" android:color="#66FFFFFF"/>
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
