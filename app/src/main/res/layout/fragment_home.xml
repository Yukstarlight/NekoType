<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ================= 顶部 Hero ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hero"
            android:elevation="4dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_hero_logo">
                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ctw_icon"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_pic_mask"
                        android:clipToOutline="true"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/t0"
                        android:textColor="@color/hero_text"
                        android:textSize="22sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/t1"
                        android:textColor="@color/hero_text_soft"
                        android:textSize="11sp"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp">
                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/t3"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"/>
                <TextView
                    android:id="@+id/tvStats"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/t4"
                    android:textColor="@color/hero_text_soft"
                    android:textSize="11sp"/>
                <TextView
                    android:id="@+id/btnLanguage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_language"
                    android:textColor="@color/hero_text_soft"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_glass"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:id="@+id/btnToggleService"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/t5"
                    android:textColor="@color/brand_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_white"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 权限引导 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorSurface">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/t8"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"/>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/t9"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="2dp"/>

                    <!-- 步骤 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="12dp">
                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:text="@string/t10"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:gravity="center"
                            android:background="@drawable/bg_circle"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/t11"
                                android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface"/>
                            <TextView
                                android:id="@+id/tvStep1Status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/t12"
                                android:textSize="11sp"
                                android:textColor="@color/warn_amber"/>
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStep1"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="36dp"
                            android:textSize="12sp"
                            android:text="@string/t13"/>
                    </LinearLayout>

                    <!-- 步骤 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="10dp">
                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:text="@string/t14"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:gravity="center"
                            android:background="@drawable/bg_circle"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/t15"
                                android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface"/>
                            <TextView
                                android:id="@+id/tvStep2Status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/t16"
                                android:textSize="11sp"
                                android:textColor="@color/warn_amber"/>
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStep2"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="36dp"
                            android:textSize="12sp"
                            android:text="@string/t17"/>
                    </LinearLayout>

                    <!-- 步骤 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="10dp">
                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:text="@string/t18"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:gravity="center"
                            android:background="@drawable/bg_circle"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/t19"
                                android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface"/>
                            <TextView
                                android:id="@+id/tvStep3Status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/t20"
                                android:textSize="11sp"
                                android:textColor="@color/warn_amber"/>
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStep3"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="36dp"
                            android:textSize="12sp"
                            android:text="@string/t21"/>
                    </LinearLayout>

                    <!-- 步骤 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="10dp">
                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:text="@string/t22"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:gravity="center"
                            android:background="@drawable/bg_circle"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/t23"
                                android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface"/>
                            <TextView
                                android:id="@+id/tvStep4Status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/t24"
                                android:textSize="11sp"
                                android:textColor="@color/warn_amber"/>
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStep4"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="36dp"
                            android:textSize="12sp"
                            android:text="@string/t25"/>
                    </LinearLayout>

                    <!-- 步骤 5 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="10dp">
                        <TextView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:text="@string/t26"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary"
                            android:gravity="center"
                            android:background="@drawable/bg_circle"/>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/t27"
                                android:textSize="14sp"
                                android:textColor="?attr/colorOnSurface"/>
                            <TextView
                                android:id="@+id/tvStep5Status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/t28"
                                android:textSize="11sp"
                                android:textColor="@color/warn_amber"/>
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnStep5Shizuku"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="36dp"
                            android:textSize="12sp"
                            android:text="@string/t29"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvWizardDone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/ok_green"
                        android:layout_marginTop="12dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 状态总览 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/t30"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"/>
            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="6dp">
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipOverlay"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/t31"
                    android:checkable="true"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAccessibility"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/t32"
                    android:checkable="true"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBattery"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/t33"
                    android:checkable="true"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipShizuku"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/t34"
                    android:checkable="true"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRoot"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/t35"
                    android:checkable="true"/>
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAdmin"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/t36"
                    android:checkable="true"/>
            </com.google.android.material.chip.ChipGroup>

            <!-- 系统能力 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/t37"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBatteryPriv"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="46dp"
                android:textSize="13sp"
                android:text="@string/t38"/>
            <TextView
                android:id="@+id/tvPrivLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="10dp"
                android:textIsSelectable="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="28dp"
                android:text="@string/t73"/>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
