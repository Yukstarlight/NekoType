<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:id="@+id/terminalTitleBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:background="#80000000">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ctw_icon"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_pic_mask"
            android:clipToOutline="true"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="@string/terminal_title"
            android:textSize="@dimen/ts_16"
            android:textStyle="bold"
            android:textColor="#E0E0FF"/>

        <TextView
            android:id="@+id/tvTerminalStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textSize="@dimen/ts_10"
            android:textColor="#4CAF50"
            android:layout_marginEnd="4dp"/>

        <!-- 补全按钮：对当前输入做命令补全（手机无Tab键） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTabComplete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="⇥"
            android:textColor="#B0B0D0"
            android:textSize="@dimen/ts_16"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"/>

        <!-- 设置按钮：字体大小 / 透明度调节 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTerminalSettings"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="⚙"
            android:textColor="#B0B0D0"
            android:textSize="@dimen/ts_18"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseTerminal"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/terminal_close"
            android:textColor="#B0B0D0"
            android:textSize="@dimen/ts_13"/>
    </LinearLayout>

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#305080A0"/>

    <!-- 终端视图 -->
    <com.termux.view.TerminalView
        android:id="@+id/terminalView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#00000000"
        android:padding="4dp"/>

    <!-- 底部快捷命令面板 -->
    <LinearLayout
        android:id="@+id/quickCmdPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#80000000">

        <!-- 展开/折叠按钮 -->
        <TextView
            android:id="@+id/btnToggleQuickCmd"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="@string/i3"
            android:textColor="#90A0C0"
            android:textSize="@dimen/ts_12"
            android:foreground="?attr/selectableItemBackground"/>

        <!-- 快捷命令按钮区（默认隐藏，三行布局） -->
        <LinearLayout
            android:id="@+id/quickCmdScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <!-- 第一行：系统命令 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/cmdLs" style="@style/TerminalQuickCmd" android:layout_weight="1" android:text="ls"/>
                <TextView android:id="@+id/cmdLsLa" style="@style/TerminalQuickCmd" android:layout_weight="1" android:text="ls -la"/>
                <TextView android:id="@+id/cmdCdSdcard" style="@style/TerminalQuickCmd" android:layout_weight="1" android:text="cd /sdcard"/>
                <TextView android:id="@+id/cmdPwd" style="@style/TerminalQuickCmd" android:layout_weight="1" android:text="pwd"/>
                <TextView android:id="@+id/cmdPs" style="@style/TerminalQuickCmd" android:layout_weight="1" android:text="ps -A"/>
                <TextView android:id="@+id/cmdDf" style="@style/TerminalQuickCmd" android:layout_weight="1" android:text="df -h"/>
            </LinearLayout>

            <!-- 第二行：常用操作 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">
                <TextView android:id="@+id/cmdClear" style="@style/TerminalQuickCmd" android:layout_weight="1" android:text="clear"/>
                <TextView android:id="@+id/cmdHelp" style="@style/TerminalQuickCmd" android:layout_weight="1" android:text="help"/>
                <TextView android:id="@+id/cmdExit" style="@style/TerminalQuickCmd" android:layout_weight="1" android:text="exit"/>
                <TextView android:id="@+id/cmdDate" style="@style/TerminalQuickCmd" android:layout_weight="1" android:text="date"/>
                <TextView android:id="@+id/cmdWhoami" style="@style/TerminalQuickCmd" android:layout_weight="1" android:text="whoami"/>
                <TextView android:id="@+id/cmdUname" style="@style/TerminalQuickCmd" android:layout_weight="1" android:text="uname"/>
            </LinearLayout>

            <!-- 第三行：NekoType 趣味命令 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">
                <TextView android:id="@+id/cmdNekosay" style="@style/TerminalQuickCmd" android:layout_weight="1" android:text="nekosay"/>
                <TextView android:id="@+id/cmdFortune" style="@style/TerminalQuickCmd" android:layout_weight="1" android:text="fortune"/>
                <TextView android:id="@+id/cmdNekomood" style="@style/TerminalQuickCmd" android:layout_weight="1" android:text="nekomood"/>
                <TextView android:id="@+id/cmdCatbomb" style="@style/TerminalQuickCmd" android:layout_weight="1" android:text="catbomb"/>
                <TextView android:id="@+id/cmdCatstop" style="@style/TerminalQuickCmd" android:layout_weight="1" android:text="catstop"/>
                <TextView android:id="@+id/cmdNeko" style="@style/TerminalQuickCmd" android:layout_weight="1" android:text="neko"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
