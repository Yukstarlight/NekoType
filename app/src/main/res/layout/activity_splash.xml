<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <!-- 应用图标（圆形裁剪） -->
        <ImageView
            android:id="@+id/ivSplashIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ctw_icon"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_splash_icon_circle"
            android:padding="2dp"
            android:alpha="0"
            android:scaleX="0.3"
            android:scaleY="0.3"/>

        <!-- 应用名称 -->
        <TextView
            android:id="@+id/tvSplashTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:alpha="0"
            android:translationY="20dp"/>

        <!-- 副标题 -->
        <TextView
            android:id="@+id/tvSplashSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/splash_subtitle"
            android:textSize="13sp"
            android:textColor="#CCFFFFFF"
            android:alpha="0"
            android:translationY="15dp"/>

    </LinearLayout>

    <!-- 底部小字 -->
    <TextView
        android:id="@+id/tvSplashVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:text="@string/splash_version"
        android:textSize="11sp"
        android:textColor="#88FFFFFF"
        android:alpha="0"/>

</FrameLayout>
