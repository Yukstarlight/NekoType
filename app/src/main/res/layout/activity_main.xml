<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient_app">

    <!-- ================= 头部 ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_hero"
        android:elevation="4dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_hero_logo">
                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ctw_icon"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_pic_mask"
                    android:clipToOutline="true"/>
            </FrameLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NekoType"
                    android:textColor="@color/hero_text"
                    android:textSize="22sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="消息文本自定义 · 悬浮按钮 · 系统级增强"
                    android:textColor="@color/hero_text_soft"
                    android:textSize="11sp"
                    android:layout_marginTop="1dp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="⚙"
                android:textSize="20sp"
                android:gravity="center"
                android:background="@drawable/bg_pill_hero"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="设置"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="○ 已停止"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"/>
            <TextView
                android:id="@+id/tvStats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="累计 0 次"
                android:textColor="@color/hero_text_soft"
                android:textSize="11sp"/>
            <TextView
                android:id="@+id/btnToggleService"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="启动服务"
                android:textColor="@color/brand_dark"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/bg_btn_white"
                android:foreground="?attr/selectableItemBackground"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ================= 选项卡 ================= -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card_glass"
        app:tabIndicatorColor="?attr/colorPrimary"
        app:tabIndicatorFullWidth="false"
        app:tabSelectedTextColor="?attr/colorPrimary"
        app:tabTextColor="?attr/colorOnSurfaceVariant"
        app:tabRippleColor="?attr/colorPrimaryContainer">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="权限" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="规则" />
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ================= 选项卡 1：权限 ================= -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/tabPermissions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 权限引导 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/surface_card_glass">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="权限引导（按顺序完成）"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="全部完成后，悬浮按钮即可常驻屏幕边缘"
                            android:textSize="12sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginTop="2dp"/>

                        <!-- 步骤 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingTop="12dp">
                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:text="1"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary"
                                android:gravity="center"
                                android:background="@drawable/bg_circle"/>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="无障碍服务"
                                    android:textSize="14sp"
                                    android:textColor="?attr/colorOnSurface"/>
                                <TextView
                                    android:id="@+id/tvStep1Status"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="未开启"
                                    android:textSize="11sp"
                                    android:textColor="@color/warn_amber"/>
                            </LinearLayout>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnStep1"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="36dp"
                                android:textSize="12sp"
                                android:text="去开启"/>
                        </LinearLayout>

                        <!-- 步骤 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingTop="10dp">
                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:text="2"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary"
                                android:gravity="center"
                                android:background="@drawable/bg_circle"/>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="设备管理员"
                                    android:textSize="14sp"
                                    android:textColor="?attr/colorOnSurface"/>
                                <TextView
                                    android:id="@+id/tvStep2Status"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="未激活"
                                    android:textSize="11sp"
                                    android:textColor="@color/warn_amber"/>
                            </LinearLayout>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnStep2"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="36dp"
                                android:textSize="12sp"
                                android:text="去激活"/>
                        </LinearLayout>

                        <!-- 步骤 3 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingTop="10dp">
                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:text="3"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary"
                                android:gravity="center"
                                android:background="@drawable/bg_circle"/>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="关闭省电优化"
                                    android:textSize="14sp"
                                    android:textColor="?attr/colorOnSurface"/>
                                <TextView
                                    android:id="@+id/tvStep3Status"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="未免电"
                                    android:textSize="11sp"
                                    android:textColor="@color/warn_amber"/>
                            </LinearLayout>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnStep3"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="36dp"
                                android:textSize="12sp"
                                android:text="去免电"/>
                        </LinearLayout>

                        <!-- 步骤 4 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingTop="10dp">
                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:text="4"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary"
                                android:gravity="center"
                                android:background="@drawable/bg_circle"/>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="显示在应用上层"
                                    android:textSize="14sp"
                                    android:textColor="?attr/colorOnSurface"/>
                                <TextView
                                    android:id="@+id/tvStep4Status"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="未授权"
                                    android:textSize="11sp"
                                    android:textColor="@color/warn_amber"/>
                            </LinearLayout>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnStep4"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="36dp"
                                android:textSize="12sp"
                                android:text="去授权"/>
                        </LinearLayout>

                        <!-- 步骤 5 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingTop="10dp">
                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:text="5"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorPrimary"
                                android:gravity="center"
                                android:background="@drawable/bg_circle"/>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Shizuku 权限"
                                    android:textSize="14sp"
                                    android:textColor="?attr/colorOnSurface"/>
                                <TextView
                                    android:id="@+id/tvStep5Status"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="可选（或使用基础模式）"
                                    android:textSize="11sp"
                                    android:textColor="@color/warn_amber"/>
                            </LinearLayout>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnStep5Shizuku"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="36dp"
                                android:textSize="12sp"
                                android:text="请求"/>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnStep5Basic"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="36dp"
                                android:textSize="12sp"
                                android:text="基础模式"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvWizardDone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/ok_green"
                            android:layout_marginTop="12dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 状态总览 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="权限状态"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"/>
                <com.google.android.material.chip.ChipGroup
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp">
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipOverlay"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="悬浮窗"
                        android:checkable="true"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAccessibility"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="无障碍"
                        android:checkable="true"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBattery"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="免电"
                        android:checkable="true"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipShizuku"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shizuku"
                        android:checkable="true"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRoot"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Root"
                        android:checkable="true"/>
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAdmin"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="管理员"
                        android:checkable="true"/>
                </com.google.android.material.chip.ChipGroup>

                <!-- 系统能力 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="系统能力"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="8dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBatteryPriv"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="46dp"
                    android:textSize="13sp"
                    android:text="一键免电（Shizuku / Root 直写）"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRoot"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="46dp"
                    android:textSize="13sp"
                    android:text="Root 测试"/>
                <TextView
                    android:id="@+id/tvPrivLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="10dp"
                    android:textIsSelectable="true"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ================= 选项卡 2：规则 ================= -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/tabRules"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 规则预设 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/surface_card_glass">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="规则预设"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"/>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="10dp">
                            <TextView
                                android:id="@+id/tvActiveRule"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="当前：默认规则"
                                android:textSize="14sp"
                                android:textColor="?attr/colorOnSurfaceVariant"/>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnSelectRule"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="36dp"
                                android:textSize="12sp"
                                android:text="选择"/>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnDeleteRule"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="36dp"
                                android:textSize="12sp"
                                android:text="删除"/>
                        </LinearLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="每套预设拥有独立的规则列表"
                            android:textSize="11sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 规则列表 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/surface_card_glass"
                    android:layout_marginTop="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="已添加规则"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorOnSurface"/>
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAddRule"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minHeight="36dp"
                                android:textSize="12sp"
                                android:text="添加规则"/>
                        </LinearLayout>

                        <!-- 动态规则列表容器 -->
                        <LinearLayout
                            android:id="@+id/llRuleList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="6dp"/>

                        <TextView
                            android:id="@+id/tvEmptyRules"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="还没有规则，点击「添加规则」开始"
                            android:textSize="13sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:gravity="center"
                            android:paddingTop="16dp"
                            android:paddingBottom="16dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 行为与样式 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/surface_card_glass"
                    android:layout_marginTop="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="行为与样式"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"
                            android:paddingBottom="6dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="字符间加空格"
                                android:textSize="15sp"
                                android:textColor="?attr/colorOnSurface"/>
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/swStyleSpaced"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="转为大写"
                                android:textSize="15sp"
                                android:textColor="?attr/colorOnSurface"/>
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/swStyleUpper"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="改写后自动发送"
                                android:textSize="15sp"
                                android:textColor="?attr/colorOnSurface"/>
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/swAutoSend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="点击震动反馈"
                                android:textSize="15sp"
                                android:textColor="?attr/colorOnSurface"/>
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/swHaptic"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="拖拽后边缘吸附"
                                android:textSize="15sp"
                                android:textColor="?attr/colorOnSurface"/>
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/swSnap"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 效果预览 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/divider"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/surface_card_glass"
                    android:layout_marginTop="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="效果预览"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurface"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="输入"
                            android:textSize="11sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginTop="10dp"/>
                        <EditText
                            android:id="@+id/etPreviewInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_bubble_in"
                            android:hint="输入一段测试消息"
                            android:inputType="textMultiLine"
                            android:minHeight="52dp"
                            android:padding="14dp"
                            android:gravity="top|start"
                            android:textColor="?attr/colorOnSurface"
                            android:textColorHint="?attr/colorOnSurfaceVariant"
                            android:layout_marginTop="4dp"/>
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPreview"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="预览变换结果"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="输出"
                            android:textSize="11sp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:layout_marginTop="14dp"/>
                        <TextView
                            android:id="@+id/tvPreviewOutput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_bubble_out"
                            android:padding="14dp"
                            android:textSize="15sp"
                            android:textColor="?attr/colorOnSurface"
                            android:minHeight="52dp"
                            android:gravity="top|start"
                            android:textIsSelectable="true"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvTileHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="28dp"
                    android:text="小贴士：可在系统快捷设置面板添加「NekoType」磁贴，下拉即可一键开关服务；更多选项见右上角设置。"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</LinearLayout>
