<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 规则预设（标题旁带加号选择规则） -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="?attr/colorSurface">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 标题行：标题 + 新建按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/t39"
                        android:textSize="@dimen/ts_16"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"/>
                    <!-- 加号按钮：新建预设（用矢量图标，避免文字 "+" 渲染成空白） -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddPreset"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text=""
                        app:icon="@drawable/ic_add"
                        app:iconSize="22dp"
                        app:iconPadding="0dp"
                        app:iconGravity="textStart"
                        android:contentDescription="@string/t41"/>
                </LinearLayout>

                <!-- 操作按钮列（Y 轴纵向，靠卡片左侧）：选择预设在上 → 删除居中 → 管理在下 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="2dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectRule"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="38dp"
                        android:textSize="@dimen/ts_15"
                        android:text="@string/pm_btn_select"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeleteRule"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="38dp"
                        android:textSize="@dimen/ts_15"
                        android:text="@string/pm_btn_delete"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnManagePreset"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="38dp"
                        android:textSize="@dimen/ts_15"
                        android:text="@string/pm_manage"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvActiveRule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/t40"
                    android:textSize="@dimen/ts_14"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="8dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/t43"
                    android:textSize="@dimen/ts_11"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 规则列表 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="?attr/colorSurface"
            android:layout_marginTop="14dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/t44"
                        android:textSize="@dimen/ts_16"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"/>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddRule"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="36dp"
                        android:textSize="@dimen/ts_12"
                        android:text="@string/t45"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llRuleList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:id="@+id/tvEmptyRules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/t46"
                    android:textSize="@dimen/ts_13"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 行为与样式 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="?attr/colorSurface"
            android:layout_marginTop="14dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/t47"
                    android:textSize="@dimen/ts_16"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:paddingBottom="6dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/t48"
                        android:textSize="@dimen/ts_15"
                        android:textColor="?attr/colorOnSurface"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swStyleSpaced"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/t49"
                        android:textSize="@dimen/ts_15"
                        android:textColor="?attr/colorOnSurface"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swStyleUpper"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/t50"
                        android:textSize="@dimen/ts_15"
                        android:textColor="?attr/colorOnSurface"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swAutoSend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/t51"
                        android:textSize="@dimen/ts_15"
                        android:textColor="?attr/colorOnSurface"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swHaptic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/t52"
                        android:textSize="@dimen/ts_15"
                        android:textColor="?attr/colorOnSurface"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swSnap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/t53"
                        android:textSize="@dimen/ts_15"
                        android:textColor="?attr/colorOnSurface"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swSilentModify"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/t54"
                    android:textSize="@dimen/ts_11"
                    android:textColor="?attr/colorOnSurfaceVariant"/>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/t57"
                        android:textSize="@dimen/ts_15"
                        android:textColor="?attr/colorOnSurface"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swPunctTrigger"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/t58"
                    android:textSize="@dimen/ts_11"
                    android:textColor="?attr/colorOnSurfaceVariant"/>
                <!-- 自定义触发标点 -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPunctChars"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:hintEnabled="false"
                    app:boxBackgroundMode="outline">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPunctChars"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="自定义触发标点（如 。！？，）"
                        android:textSize="@dimen/ts_14"
                        android:inputType="text"
                        android:maxLines="1"/>
                </com.google.android.material.textfield.TextInputLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/t59"
                        android:textSize="@dimen/ts_15"
                        android:textColor="?attr/colorOnSurface"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swEmoticon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/t60"
                    android:textSize="@dimen/ts_11"
                    android:textColor="?attr/colorOnSurfaceVariant"/>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/t1001"
                        android:textSize="@dimen/ts_15"
                        android:textColor="?attr/colorOnSurface"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swDeleteOptimize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/t1002"
                    android:textSize="@dimen/ts_11"
                    android:textColor="?attr/colorOnSurfaceVariant"/>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/t1003"
                        android:textSize="@dimen/ts_15"
                        android:textColor="?attr/colorOnSurface"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swVoiceOptimize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/t1004"
                    android:textSize="@dimen/ts_11"
                    android:textColor="?attr/colorOnSurfaceVariant"/>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/i43"
                        android:textSize="@dimen/ts_15"
                        android:textColor="?attr/colorOnSurface"/>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swPriorityGlobal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/i44"
                    android:textSize="@dimen/ts_11"
                    android:textColor="?attr/colorOnSurfaceVariant"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 效果预览 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="?attr/colorSurface"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="28dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/t69"
                    android:textSize="@dimen/ts_16"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/t70"
                    android:textSize="@dimen/ts_11"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="10dp"/>
                <EditText
                    android:id="@+id/etPreviewInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_bubble_in"
                    android:hint="@string/i2"
                    android:inputType="textMultiLine"
                    android:minHeight="52dp"
                    android:padding="14dp"
                    android:gravity="top|start"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="4dp"/>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPreview"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/t71"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/t72"
                    android:textSize="@dimen/ts_11"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="14dp"/>
                <TextView
                    android:id="@+id/tvPreviewOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_bubble_out"
                    android:padding="14dp"
                    android:textSize="@dimen/ts_15"
                    android:textColor="?attr/colorOnSurface"
                    android:minHeight="52dp"
                    android:gravity="top|start"
                    android:textIsSelectable="true"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
