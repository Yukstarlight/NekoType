<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient_app">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ap_title"
                android:textSize="@dimen/ts_17"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ap_switch"
                android:textSize="@dimen/ts_12"
                android:textColor="?attr/colorOnSurfaceVariant"/>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/swMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ap_hint"
            android:textSize="@dimen/ts_12"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/btnAdd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ap_add"
            android:textSize="@dimen/ts_13"
            android:textColor="?attr/colorPrimary"
            android:gravity="center"
            android:padding="10dp"
            android:background="@drawable/bg_bubble_in"
            android:foreground="?attr/selectableItemBackground"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ap_empty"
            android:textSize="@dimen/ts_12"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:padding="16dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:id="@+id/llMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"/>
    </ScrollView>
</LinearLayout>
