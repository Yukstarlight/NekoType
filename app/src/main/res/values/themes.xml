<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 窗口动画：赛博朋克风格切换 -->
    <style name="NekoWindowAnim" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/cyber_activity_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/cyber_activity_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/cyber_activity_enter</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>

    <!-- 浅色模式（Day） -->
    <style name="Theme.NekoType" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/md_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/glass_strong</item>
        <item name="colorOnPrimaryContainer">@color/fg_0</item>
        <item name="colorSecondary">@color/accent_purple</item>
        <item name="colorOnSecondary">@color/md_theme_onPrimary</item>
        <item name="colorSecondaryContainer">@color/glass_strong</item>
        <item name="colorOnSecondaryContainer">@color/fg_0</item>
        <!-- 浅色主题 surface 保持近实心白，避免半透明叠浅灰底形成"灰色方框" -->
        <item name="colorSurface">#F5FFFFFF</item>
        <item name="colorOnSurface">@color/fg_0</item>
        <item name="colorOnSurfaceVariant">@color/fg_1</item>
        <item name="colorOutlineVariant">@color/border_glass</item>
        <!-- 窗口背景用主题色（不透明）：进入页面不闪屏；退出动画已禁用（NekoWindowAnim），不会黑波纹 -->
        <item name="android:windowBackground">@color/bg_0</item>
        <item name="android:statusBarColor">@color/bg_0</item>
        <item name="android:navigationBarColor">@color/bg_0</item>
        <item name="android:windowLightStatusBar">@bool/light_status_bar</item>
        <item name="android:windowAnimationStyle">@style/NekoWindowAnim</item>
    </style>

    <!-- 主界面：无 ActionBar（全沉浸式，自定义头部） -->
    <style name="Theme.NekoType.Main" parent="Theme.NekoType">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- 星空模式：深蓝紫夜空 + 紫金星光（配色来自 NekoType 官网） -->
    <style name="Theme.NekoType.Star" parent="Theme.NekoType.Main">
        <item name="colorPrimary">@color/star_primary</item>
        <item name="colorOnPrimary">@color/star_onPrimary</item>
        <item name="colorPrimaryContainer">@color/star_container</item>
        <item name="colorOnPrimaryContainer">@color/star_onContainer</item>
        <item name="colorSecondary">@color/star_secondary</item>
        <item name="colorOnSecondary">@color/star_onSecondary</item>
        <item name="colorSecondaryContainer">@color/star_container</item>
        <item name="colorOnSecondaryContainer">@color/star_onContainer</item>
        <item name="colorSurface">#3311162D</item>
        <item name="colorOnSurface">@color/star_fg0</item>
        <item name="colorOnSurfaceVariant">@color/star_fg1</item>
        <item name="colorOutlineVariant">@color/star_border</item>
        <item name="android:windowBackground">@drawable/bg_starfield</item>
        <item name="android:statusBarColor">@color/star_bg0</item>
        <item name="android:navigationBarColor">@color/star_bg0</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- 猫娘模式：粉紫可爱风 + 猫爪元素 -->
    <style name="Theme.NekoType.Neko" parent="Theme.NekoType.Main">
        <item name="colorPrimary">@color/neko_primary</item>
        <item name="colorOnPrimary">@color/neko_onPrimary</item>
        <item name="colorPrimaryContainer">@color/neko_secondary</item>
        <item name="colorOnPrimaryContainer">@color/neko_text_light</item>
        <item name="colorSecondary">@color/neko_accent</item>
        <item name="colorOnSecondary">@color/neko_onPrimary</item>
        <item name="colorSecondaryContainer">@color/neko_secondary</item>
        <item name="colorOnSecondaryContainer">@color/neko_text_light</item>
        <item name="colorSurface">#66FFF0F8</item>
        <item name="colorOnSurface">@color/neko_text_light</item>
        <item name="colorOnSurfaceVariant">@color/neko_text_soft_light</item>
        <item name="colorOutlineVariant">#22E0A0C0</item>
        <item name="android:windowBackground">@drawable/bg_neko</item>
        <item name="android:statusBarColor">@color/neko_primary_dark</item>
        <item name="android:navigationBarColor">@color/neko_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- 启动页主题：全屏、无ActionBar、背景与启动页一致避免闪屏 -->
    <style name="Theme.NekoType.Splash" parent="Theme.NekoType.Main">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">#1A1030</item>
        <item name="android:navigationBarColor">#1A1030</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <!-- 前苏联主题：红旗红 + 鎏金，构造主义斜带背景 -->
    <style name="Theme.NekoType.Cccp" parent="Theme.NekoType.Main">
        <item name="colorPrimary">@color/cccp_red</item>
        <item name="colorOnPrimary">@color/cccp_text</item>
        <item name="colorPrimaryContainer">@color/cccp_red_dark</item>
        <item name="colorOnPrimaryContainer">@color/cccp_text</item>
        <item name="colorSecondary">@color/cccp_gold</item>
        <item name="colorOnSecondary">@color/cccp_bg</item>
        <item name="colorSecondaryContainer">@color/cccp_red_dark</item>
        <item name="colorOnSecondaryContainer">@color/cccp_gold</item>
        <item name="colorSurface">@color/cccp_surface</item>
        <item name="colorOnSurface">@color/cccp_text</item>
        <item name="colorOnSurfaceVariant">@color/cccp_text_soft</item>
        <item name="colorOutlineVariant">#40E8C36A</item>
        <item name="android:windowBackground">@color/cccp_bg</item>
        <item name="android:statusBarColor">@color/cccp_bg</item>
        <item name="android:navigationBarColor">@color/cccp_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowAnimationStyle">@style/NekoWindowAnim</item>
    </style>
</resources>
